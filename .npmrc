# Generated by `pnpm eject`. @gauntlet/* and @app-brew/* are published to our
# internal verdaccio (npm.appbrew.tech), which also proxies npmjs for everything
# else. The token below is a read-only, broker-minted token — safe to commit
# because read-only tokens can only fetch tarballs, not publish or mutate.
# Before sharing repo access with the app team, mint them their own token via
# tools/verdaccio-broker/bin/npm-token.mjs.
#
# Override the token in CI/dev by exporting NPM_TOKEN.

@app-brew:registry=https://npm.appbrew.tech/
@gauntlet:registry=https://npm.appbrew.tech/
//npm.appbrew.tech/:_authToken=abnpm_Ng71hImljgyH7bFW5do7tVRat88pgwO4rc3MUzLcvJM

# Hoist node_modules into a flat npm/yarn-style layout. pnpm's default isolated
# layout (node_modules/.pnpm/<long-hash>/node_modules/<pkg>/) breaks native
# Android builds for packages whose CMake/JNI configs assume a flat tree — most
# notably react-native-reanimated, which looks for react-native-worklets's
# libworklets.so via a sibling path.
node-linker=hoisted

engine-strict=true
use-node-version=24.15.0
prefer-offline=true
